name = "turkish-tts-gateway"
main = "worker.mjs"
compatibility_date = "2026-09-02"

[vars]
MODAL_TTS_URL = "https://YOUR-MODAL-ENDPOINT.modal.run/tts"
ALLOWED_ORIGINS = "https://www.ornek-site.com,https://ornek-site.com"

# Bunları dosyaya yazmayın; `wrangler secret put` ile ekleyin:
# MODAL_PROXY_TOKEN_ID
# MODAL_PROXY_TOKEN_SECRET
